# Copie este arquivo para secrets.toml e preencha com suas credenciais.
# NUNCA commite secrets.toml no Git.

SUPABASE_URL = "https://SEU_PROJETO.supabase.co"
SUPABASE_KEY = "sua-chave-anon-ou-service-role"

# API Cobranças Banco do Brasil (Portal Developers BB)
[bb]
client_id = "seu-client-id"
client_secret = "seu-client-secret"
app_key = "sua-developer-application-key"
ambiente = "sandbox"  # sandbox | homologacao | producao
# Opcional: force os escopos. Se omitir, o app tenta os mais completos e faz fallback.
# scopes = "cobrancas.boletos-info cobrancas.boletos-requisicao"
